# 换行策略：仓库里统一存 LF，检出时按下面的规则转换
* text=auto

# Windows 工程文件按 CRLF 检出（BOM 是内容的一部分，不受影响）
*.ps1    text eol=crlf
*.cmd    text eol=crlf
*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.config text eol=crlf

# 文档与配置统一 LF，避免跨平台 diff 噪音
*.md     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf

# 二进制：绝不做换行转换，避免损坏
*.gguf   binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.zip    binary
*.ico    binary
*.png    binary
